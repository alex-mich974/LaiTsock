import { FastifyReply, FastifyRequest } from "fastify";

export async function verifierAuth(req: FastifyRequest, reply: FastifyReply) {
  try {
    await req.jwtVerify();
  } catch {
    reply.code(401).send({ erreur: "Non authentifié" });
  }
}

// Vérifie qu'un utilisateur possède une permission donnée.
// La liste de permissions est incluse dans le JWT au moment du login.
export function requiresPermission(code: string) {
  return async (req: FastifyRequest, reply: FastifyReply) => {
    const user = req.user as { permissions: string[] };
    if (!user?.permissions?.includes(code)) {
      reply.code(403).send({ erreur: `Permission manquante: ${code}` });
    }
  };
}
import { FastifyInstance } from "fastify";
import argon2 from "argon2";
import { z } from "zod";
import { prisma } from "../lib/prisma.js";

const loginSchema = z.object({
  identifiant: z.string().min(1),
  motDePasse: z.string().min(1),
});

export async function authRoutes(app: FastifyInstance) {
  app.post("/auth/login", async (req, reply) => {
    const body = loginSchema.parse(req.body);

    const utilisateur = await prisma.utilisateur.findUnique({
      where: { identifiant: body.identifiant },
      include: { role: { include: { permissions: true } } },
    });

    if (!utilisateur || !utilisateur.actif) {
      return reply.code(401).send({ erreur: "Identifiants invalides" });
    }

    const motDePasseValide = await argon2.verify(
      utilisateur.motDePasseHash,
      body.motDePasse
    );

    if (!motDePasseValide) {
      return reply.code(401).send({ erreur: "Identifiants invalides" });
    }

    const permissions = utilisateur.role.permissions.map((p) => p.code);

    const token = app.jwt.sign(
      {
        sub: utilisateur.id,
        nomComplet: utilisateur.nomComplet,
        role: utilisateur.role.nom,
        permissions,
      },
      { expiresIn: "12h" }
    );

    await prisma.auditLog.create({
      data: {
        utilisateurId: utilisateur.id,
        action: "LOGIN",
      },
    });

    return {
      token,
      utilisateur: {
        id: utilisateur.id,
        nomComplet: utilisateur.nomComplet,
        role: utilisateur.role.nom,
        permissions,
      },
    };
  });
}
