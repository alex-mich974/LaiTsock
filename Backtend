generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMINISTRATEUR
  MANAGER
  CAISSIER
  SERVEUR
  CUISINIER
}

model Role {
  id          String       @id @default(uuid())
  nom         RoleName     @unique
  permissions Permission[]
  utilisateurs Utilisateur[]
  createdAt   DateTime     @default(now())
}

model Permission {
  id     String @id @default(uuid())
  code   String @unique // ex: "COMMANDE_CREER", "PRIX_MODIFIER", "RAPPORTS_VOIR"
  label  String
  roles  Role[]
}

model Utilisateur {
  id            String    @id @default(uuid())
  nomComplet    String
  identifiant   String    @unique // login
  motDePasseHash String
  roleId        String
  role          Role      @relation(fields: [roleId], references: [id])
  actif         Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  auditLogs     AuditLog[]
}

model AuditLog {
  id            String       @id @default(uuid())
  utilisateurId String?
  utilisateur   Utilisateur? @relation(fields: [utilisateurId], references: [id])
  action        String       // ex: "LOGIN", "COMMANDE_CREEE", "PRIX_MODIFIE"
  cible         String?      // ex: "commande:uuid"
  avant         Json?
  apres         Json?
  createdAt     DateTime     @default(now())
}

// File d'attente de synchronisation offline-first.
// Chaque poste client pousse ici les événements créés hors-ligne.
model SyncEvent {
  id            String   @id @default(uuid())
  posteId       String   // identifiant du poste client (ex: uuid généré au premier lancement)
  entite        String   // ex: "commande", "paiement", "mouvement_stock"
  entiteId      String   // uuid généré côté client
  action        String   // "CREATE" | "UPDATE"
  payload       Json
  createdAtClient DateTime // horodatage côté client, au moment de l'action réelle
  receivedAt    DateTime @default(now())
  traite        Boolean  @default(false)
}
import { PrismaClient } from "@prisma/client";
import argon2 from "argon2";

const prisma = new PrismaClient();

const PERMISSIONS = [
  { code: "COMMANDE_CREER", label: "Créer une commande" },
  { code: "COMMANDE_MODIFIER", label: "Modifier une commande" },
  { code: "PRIX_MODIFIER", label: "Modifier les prix" },
  { code: "CAISSE_ENCAISSER", label: "Encaisser un paiement" },
  { code: "CAISSE_CLOTURER", label: "Clôturer la caisse" },
  { code: "STOCK_GERER", label: "Gérer les stocks" },
  { code: "RAPPORTS_VOIR", label: "Voir les rapports financiers" },
  { code: "PERSONNEL_GERER", label: "Gérer le personnel et les permissions" },
  { code: "CUISINE_VOIR", label: "Voir l'écran cuisine" },
];

const ROLE_PERMISSIONS: Record<string, string[]> = {
  ADMINISTRATEUR: PERMISSIONS.map((p) => p.code),
  MANAGER: [
    "COMMANDE_CREER", "COMMANDE_MODIFIER", "CAISSE_ENCAISSER",
    "CAISSE_CLOTURER", "STOCK_GERER", "RAPPORTS_VOIR", "CUISINE_VOIR",
  ],
  CAISSIER: ["CAISSE_ENCAISSER", "CAISSE_CLOTURER"],
  SERVEUR: ["COMMANDE_CREER", "COMMANDE_MODIFIER"],
  CUISINIER: ["CUISINE_VOIR"],
};

async function main() {
  for (const p of PERMISSIONS) {
    await prisma.permission.upsert({
      where: { code: p.code },
      update: {},
      create: p,
    });
  }

  for (const [roleName, permCodes] of Object.entries(ROLE_PERMISSIONS)) {
    await prisma.role.upsert({
      where: { nom: roleName as any },
      update: {
        permissions: { set: permCodes.map((code) => ({ code })) },
      },
      create: {
        nom: roleName as any,
        permissions: { connect: permCodes.map((code) => ({ code })) },
      },
    });
  }

  const adminRole = await prisma.role.findUniqueOrThrow({
    where: { nom: "ADMINISTRATEUR" },
  });

  const hash = await argon2.hash("admin123"); // à changer immédiatement en prod

  await prisma.utilisateur.upsert({
    where: { identifiant: "admin" },
    update: {},
    create: {
      nomComplet: "Administrateur",
      identifiant: "admin",
      motDePasseHash: hash,
      roleId: adminRole.id,
    },
  });

  console.log("Seed terminé. Login: admin / admin123 (à changer !)");
}

main()
  .catch((e) => {
    console.error(e);
    process.exit(1);
  })
  .finally(() => prisma.$disconnect());
